/* components/custom-toast/custom-toast.wxss */
.custom-toast {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.custom-toast.show {
  opacity: 1;
  visibility: visible;
}

.toast-content {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 40rpx;
  max-width: 600rpx;
  min-width: 400rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
}

.toast-icon {
  width: 60rpx;
  height: 60rpx;
  margin: 0 auto 30rpx;
  display: block;
}

.toast-message {
  font-size: 32rpx;
  line-height: 1.5;
  text-align: center;
  word-break: break-all;
  max-height: 400rpx;
  overflow-y: auto;
}

.toast-message.error {
  color: #e64340;
}

.toast-message.success {
  color: #09bb07;
}